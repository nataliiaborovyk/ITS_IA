      ],
      "webhookId": "cd7152c5-3511-435a-ba93-2c460afb423d"
    },
    {
      "parameters": {
        "jsCode": "// ── Estrae città, zone e maxItems dall'input testuale ──────────────\n// Formati supportati:\n//   \"Milano\"                   → tutta la città, 50 pagine (default)\n//   \"Milano Brera\"             → una zona\n//   \"Milano Brera, Navigli\"    → più zone\n//   \"Milano Brera, Navigli, 100\" → più zone + maxItems esplicito\n//   \"Roma, 200\"                → tutta la città, 200 pagine\n//\n// maxItems = numero di pagine Apify da scrapare (~18 annunci/pagina).\n// Se l'ultima voce separata da virgola è un numero puro → è il maxItems.\n\nconst text = ($json.chatInput ?? '').trim();\nconst DEFAULT_MAX_ITEMS = 200;\n\nif (!text) return [{ json: { city: '', zones: [], maxItems: DEFAULT_MAX_ITEMS } }];\n\nconst entries = text.split(',').map(s => s.trim()).filter(Boolean);\n\n// Controlla se l'ultima voce è un numero puro → maxItems\nlet maxItems = DEFAULT_MAX_ITEMS;\nlet dataEntries = entries;\nif (entries.length > 0 && /^\\d+$/.test(entries[entries.length - 1])) {\n  maxItems = parseInt(entries[entries.length - 1], 10);\n  dataEntries = entries.slice(0, -1);\n}\n\nif (dataEntries.length === 0) return [{ json: { city: '', zones: [], maxItems } }];\n\n// La città è sempre il primo token della prima voce\nconst firstParts = dataEntries[0].split(/\\s+/);\nconst city = firstParts[0].toLowerCase();\nconst firstZone = firstParts.slice(1).join(' ').trim(); // eventuale zona nella prima voce\n\nconst zones = [];\nif (firstZone) zones.push(firstZone);\n\nfor (let i = 1; i < dataEntries.length; i++) {\n  const e = dataEntries[i].trim();\n  // Rimuove il prefisso città se presente (es. \"Roma Pigneto\" → \"Pigneto\")\n  const stripped = e.toLowerCase().startsWith(city + ' ')\n    ? e.slice(city.length + 1).trim()\n    : e.trim();\n  if (stripped) zones.push(stripped);\n}\n\nreturn [{ json: { city, zones, maxItems } }];\n"
      },
      "id": "ec3d93a0-62e5-4913-a83c-fab6a953bef3",
      "name": "Parse Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -64,
        32
      ]
    },
    {
      "parameters": {
        "jsCode": "// ── Costruisce le startUrls per Apify ───────────────────────────────\n// city  e zones arrivano dal nodo Parse Input.\n// Se non ci sono zone specifiche, cerca tutta la città.\n\nconst city     = ($json.city     ?? 'roma').toLowerCase().trim();\nconst zones    = ($json.zones    ?? []).map(z => String(z));\nconst maxItems = ($json.maxItems ?? 20);\n\nconst slug = (s) =>\n  s.toLowerCase().trim()\n    .normalize('NFD').replace(/[\\u0300-\\u036f]/g, '')\n    .replace(/'/g, '')\n    .replace(/[^a-z0-9\\s-]/g, '')\n    .replace(/\\s+/g, '-')\n    .replace(/-+/g, '-');\n\nconst citySlug = slug(city);\n\nconst startUrls = zones.length > 0\n  ? zones.map(z => ({ url: `https://www.immobiliare.it/vendita-case/${citySlug}/${slug(z)}/` }))\n  : [{ url: `https://www.immobiliare.it/vendita-case/${citySlug}/` }];\n\nreturn [{ json: { startUrls, maxItems } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
