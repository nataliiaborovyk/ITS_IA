    {
      "parameters": {
        "jsCode": "// ── Flatten subProperties ───────────────────────────────────────────\n// L'actor Apify restituisce annunci di tipo \"Progetto\" (nuove costruzioni)\n// con le singole unità nidificate in subProperties.data[].\n// Questo nodo espande ogni unità in un item separato.\n// Gli annunci normali (senza subProperties) vengono passati invariati.\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const d = item.json;\n  const subs = d.subProperties && d.subProperties.data;\n\n  if (Array.isArray(subs) && subs.length > 0) {\n    // Progetto: espandi ogni unità, ereditando lastModified e creationDate dal padre\n    for (const sub of subs) {\n      output.push({\n        json: {\n          ...sub,\n          lastModified: sub.lastModified ?? d.lastModified,\n          creationDate: sub.creationDate ?? d.creationDate\n        }\n      });\n    }\n  } else {\n    // Annuncio normale: passa invariato\n    output.push({ json: d });\n  }\n}\n\nreturn output;\n"
      },
